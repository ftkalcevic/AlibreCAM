// The Cut Levels tab, shared by the operations that cut in levels.
IDD_OP_CUT_LEVELS DIALOGEX 0, 0, 300, 176
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Location of Cut Geometry",IDC_STATIC,4,0,292,30
    CONTROL         "At Top",IDC_CUT_AT_TOP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,10,13,50,10
    CONTROL         "At Bottom",IDC_CUT_AT_BOTTOM,"Button",BS_AUTORADIOBUTTON,64,13,56,10
    CONTROL         "Pick Top",IDC_CUT_PICK_TOP,"Button",BS_AUTORADIOBUTTON,124,13,50,10
    EDITTEXT        IDC_CUT_TOP_Z,178,11,56,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "Pick",IDC_CUT_PICK_TOP_BUTTON,238,11,50,14

    GROUPBOX        "Cut Depth Control",IDC_STATIC,4,32,292,62
    LTEXT           "Total Cut Depth:",IDC_STATIC,10,46,60,8
    EDITTEXT        IDC_CUT_TOTAL,74,44,56,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Pick",IDC_CUT_PICK_DEPTH,134,44,50,14
    LTEXT           "Rough Depth:",IDC_STATIC,10,64,60,8
    EDITTEXT        IDC_CUT_ROUGH,74,62,56,14,ES_AUTOHSCROLL
    LTEXT           "Finish Depth:",IDC_STATIC,160,64,56,8
    EDITTEXT        IDC_CUT_FINISH,220,62,56,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_CUT_RATIO,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,8,78,284,13

    GROUPBOX        "",IDC_STATIC,4,96,292,42
    LTEXT           "Rough Depth/Cut:",IDC_STATIC,10,107,66,8
    EDITTEXT        IDC_CUT_ROUGH_STEP,80,105,56,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_CUT_ROUGH_STEP_SLIDER,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,8,121,140,13
    LTEXT           "Finish Depth/Cut:",IDC_STATIC,154,107,66,8
    EDITTEXT        IDC_CUT_FINISH_STEP,224,105,56,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_CUT_FINISH_STEP_SLIDER,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,152,121,140,13

    GROUPBOX        "",IDC_STATIC,4,140,144,34
    CONTROL         "Clear Island Tops",IDC_CUT_CLEAR_ISLANDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,149,130,10
    CONTROL         "Use 3D Model to Detect Depth",IDC_CUT_USE_MODEL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,161,134,10

    GROUPBOX        "Cut Levels Ordering",IDC_STATIC,152,140,144,34

    EDITTEXT        IDC_TOOL_NUMBER,62,7,50,14,ES_AUTOHSCROLL
    LTEXT           "Type:",IDC_STATIC,155,9,30,8
    COMBOBOX        IDC_TOOL_TYPE,190,7,93,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    EDITTEXT        IDC_FEEDS_DEPARTURE,200,85,56,14,ES_AUTOHSCROLL
    LTEXT           "mm/min",IDC_STATIC,260,87,30,8

    GROUPBOX        "Transfer",IDC_STATIC,4,112,292,48

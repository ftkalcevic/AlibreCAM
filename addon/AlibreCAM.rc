    EDITTEXT        IDC_TOOL_DIAMETER,88,75,45,14,ES_AUTOHSCROLL
    LTEXT           "Flute length:",IDC_STATIC,150,77,75,8
    EDITTEXT        IDC_TOOL_FLUTE_LENGTH,228,75,45,14,ES_AUTOHSCROLL
    LTEXT           "Overall length:",IDC_STATIC,15,95,70,8
    EDITTEXT        IDC_TOOL_OVERALL_LENGTH,88,93,45,14,ES_AUTOHSCROLL
    LTEXT           "Flute count:",IDC_STATIC,150,95,75,8
    EDITTEXT        IDC_TOOL_FLUTE_COUNT,228,93,45,14,ES_AUTOHSCROLL
    LTEXT           "Point angle (deg):",IDC_STATIC,150,113,75,8
    EDITTEXT        IDC_TOOL_POINT_ANGLE,228,111,45,14,ES_AUTOHSCROLL

    PUSHBUTTON      "?",IDC_HELP_BUTTON,7,149,14,14
    DEFPUSHBUTTON   "OK",IDOK,177,149,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,233,149,50,14
END

IDD_OPERATION DIALOGEX 0, 0, 320, 250

// AlibreCAM.rc : resources for the AlibreCAM add-on.
//
#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

/////////////////////////////////////////////////////////////////////////////
// English (Australia) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENA)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_AUS
#pragma code_page(1252)

#ifdef APSTUDIO_INVOKED
1 TEXTINCLUDE
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE
BEGIN
    "#include ""afxres.h""\r\n"
    "\0"
END

3 TEXTINCLUDE
BEGIN
    "\r\n"
    "\0"
END
#endif    // APSTUDIO_INVOKED

/////////////////////////////////////////////////////////////////////////////
// Icon

IDI_ALIBRECAM             ICON                    "res\\AlibreCAM.ico"

/////////////////////////////////////////////////////////////////////////////
// Dialog

IDD_ABOUTBOX DIALOGEX 0, 0, 250, 104
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About AlibreCAM"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDI_ALIBRECAM,IDC_STATIC,14,14,20,20
    LTEXT           "AlibreCAM Add-On for Alibre Design",IDC_STATIC,46,14,190,8,SS_NOPREFIX
    LTEXT           "Version",IDC_ADDON_VERSION,46,27,190,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2026 Frank's Workshop",IDC_STATIC,46,40,190,8,SS_NOPREFIX
    LTEXT           "Running in Alibre Design",IDC_ALIBRE_VERSION,46,58,190,16,SS_NOPREFIX
    DEFPUSHBUTTON   "OK",IDOK,186,83,50,14,WS_GROUP
END

IDD_TOOL_LIBRARY DIALOGEX 0, 0, 340, 232
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tool Library"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Library:",IDC_STATIC,7,9,26,8
    LTEXT           "",IDC_LIB_PATH,36,9,297,8,SS_NOPREFIX | SS_PATHELLIPSIS
    LTEXT           "",IDC_LIB_NOTE,7,21,326,16,SS_NOPREFIX
    CONTROL         "",IDC_LIB_LIST,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,7,40,264,162
    PUSHBUTTON      "&Add...",IDC_LIB_ADD,277,40,56,14
    PUSHBUTTON      "&Edit...",IDC_LIB_EDIT,277,58,56,14
    PUSHBUTTON      "&Copy...",IDC_LIB_COPY,277,76,56,14
    PUSHBUTTON      "&Delete",IDC_LIB_DELETE,277,94,56,14
    PUSHBUTTON      "&Other library...",IDC_LIB_OTHER,7,211,70,14
    PUSHBUTTON      "Use de&fault library",IDC_LIB_DEFAULT,83,211,80,14
    DEFPUSHBUTTON   "Close",IDOK,283,211,50,14
END

IDD_TOOL_EDIT DIALOGEX 0, 0, 290, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tool"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Number:",IDC_STATIC,7,9,50,8
    EDITTEXT        IDC_TOOL_NUMBER,62,7,50,14,ES_AUTOHSCROLL
    LTEXT           "Type:",IDC_STATIC,155,9,30,8
    COMBOBOX        IDC_TOOL_TYPE,190,7,93,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Name:",IDC_STATIC,7,27,50,8
    EDITTEXT        IDC_TOOL_NAME,62,25,221,14,ES_AUTOHSCROLL
    LTEXT           "Units:",IDC_STATIC,7,45,50,8
    COMBOBOX        IDC_TOOL_UNIT,62,43,93,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Size",IDC_STATIC,7,63,276,70
    LTEXT           "Diameter:",IDC_STATIC,15,77,70,8
    EDITTEXT        IDC_TOOL_DIAMETER,88,75,45,14,ES_AUTOHSCROLL
    LTEXT           "Flute length:",IDC_STATIC,150,77,75,8
    EDITTEXT        IDC_TOOL_FLUTE_LENGTH,228,75,45,14,ES_AUTOHSCROLL
    LTEXT           "Overall length:",IDC_STATIC,15,95,70,8
    EDITTEXT        IDC_TOOL_OVERALL_LENGTH,88,93,45,14,ES_AUTOHSCROLL
    LTEXT           "Flute count:",IDC_STATIC,150,95,75,8
    EDITTEXT        IDC_TOOL_FLUTE_COUNT,228,93,45,14,ES_AUTOHSCROLL
    LTEXT           "Point angle (deg):",IDC_STATIC,150,113,75,8
    EDITTEXT        IDC_TOOL_POINT_ANGLE,228,111,45,14,ES_AUTOHSCROLL

    DEFPUSHBUTTON   "OK",IDOK,177,149,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,233,149,50,14
END

IDD_OPERATION DIALOGEX 0, 0, 320, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Operation"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Name:",IDC_STATIC,7,9,40,8
    EDITTEXT        IDC_OP_NAME,50,7,263,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_OP_TABS,"SysTabControl32",WS_TABSTOP,7,28,306,194
    DEFPUSHBUTTON   "OK",IDOK,207,229,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,263,229,50,14
END

// One tab of the operation dialog, placed inside the tab control.
IDD_OP_PAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "This tab isn't built yet.",IDC_OP_PAGE_NOTE,10,10,200,8
END

IDD_SET_ORIGIN DIALOGEX 0, 0, 300, 236
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Set Origin"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Name:",IDC_STATIC,7,9,50,8
    EDITTEXT        IDC_ORIGIN_NAME,62,7,231,14,ES_AUTOHSCROLL

    GROUPBOX        "Picks",IDC_STATIC,7,26,286,74
    LTEXT           "Plane (Z):",IDC_STATIC,14,40,46,8
    LTEXT           "",IDC_ORIGIN_PLANE_TEXT,62,40,136,8,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Pick",IDC_ORIGIN_PLANE_PICK,202,37,40,14
    LTEXT           "Position:",IDC_STATIC,14,60,46,8
    LTEXT           "",IDC_ORIGIN_POSITION_TEXT,62,60,136,8,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Pick",IDC_ORIGIN_POSITION_PICK,202,57,40,14
    PUSHBUTTON      "Clear",IDC_ORIGIN_POSITION_CLEAR,246,57,40,14
    LTEXT           "X direction:",IDC_STATIC,14,80,46,8
    LTEXT           "",IDC_ORIGIN_X_TEXT,62,80,136,8,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Pick",IDC_ORIGIN_X_PICK,202,77,40,14
    PUSHBUTTON      "Clear",IDC_ORIGIN_X_CLEAR,246,77,40,14

    GROUPBOX        "Adjust",IDC_STATIC,7,104,286,62
    CONTROL         "Flip Z",IDC_ORIGIN_FLIP_Z,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,118,60,10
    LTEXT           "Turn X about Z:",IDC_STATIC,110,119,56,8
    COMBOBOX        IDC_ORIGIN_X_ROTATION,168,116,50,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Offset along the origin's own axes (mm):",IDC_STATIC,14,134,200,8
    LTEXT           "X:",IDC_STATIC,14,148,10,8
    EDITTEXT        IDC_ORIGIN_OFFSET_X,26,146,50,14,ES_AUTOHSCROLL
    LTEXT           "Y:",IDC_STATIC,90,148,10,8
    EDITTEXT        IDC_ORIGIN_OFFSET_Y,102,146,50,14,ES_AUTOHSCROLL
    LTEXT           "Z:",IDC_STATIC,166,148,10,8
    EDITTEXT        IDC_ORIGIN_OFFSET_Z,178,146,50,14,ES_AUTOHSCROLL

    LTEXT           "",IDC_ORIGIN_PROMPT,7,172,286,18,SS_NOPREFIX
    LTEXT           "",IDC_ORIGIN_RESULT,7,192,286,18,SS_NOPREFIX

    DEFPUSHBUTTON   "OK",IDOK,187,215,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,243,215,50,14
END

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO
BEGIN
    IDD_ABOUTBOX, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 243
        TOPMARGIN, 7
        BOTTOMMARGIN, 97
    END
END
#endif    // APSTUDIO_INVOKED

/////////////////////////////////////////////////////////////////////////////
// Version

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0904b0"
        BEGIN
            VALUE "CompanyName", "Frank's Workshop"
            VALUE "FileDescription", "AlibreCAM add-on for Alibre Design"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "AlibreCAM.dll"
            VALUE "LegalCopyright", "Copyright (C) 2026 Frank's Workshop"
            VALUE "OriginalFilename", "AlibreCAM.dll"
            VALUE "ProductName", "AlibreCAM"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0xc09, 1200
    END
END

#endif    // English (Australia) resources

/////////////////////////////////////////////////////////////////////////////
// English (Australia) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENA)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_AUS
#pragma code_page(1252)

#ifdef APSTUDIO_INVOKED
1 TEXTINCLUDE
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE
BEGIN
    "#include ""afxres.h""\r\n"
    "\0"
END

3 TEXTINCLUDE
BEGIN
    "\r\n"
    "\0"
END
#endif    // APSTUDIO_INVOKED

/////////////////////////////////////////////////////////////////////////////
// Icon

IDI_ALIBRECAM             ICON                    "res\\AlibreCAM.ico"

// The CAM tab's toolbar at each view size: square images side by side (draw over
// model, show toolpaths, settings), magenta for transparent.
IDB_CAM_TOOLBAR_16        BITMAP                  "res\\CamToolbar16.bmp"
IDB_CAM_TOOLBAR_24        BITMAP                  "res\\CamToolbar24.bmp"
IDB_CAM_TOOLBAR_32        BITMAP                  "res\\CamToolbar32.bmp"

/////////////////////////////////////////////////////////////////////////////
// Dialog

IDD_SETTINGS DIALOGEX 0, 0, 180, 92
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AlibreCAM Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "CAM View Size",IDC_STATIC,7,7,166,56
    CONTROL         "Small",IDC_VIEW_SMALL,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,20,80,10
    CONTROL         "Medium",IDC_VIEW_MEDIUM,"Button",BS_AUTORADIOBUTTON,15,33,80,10
    CONTROL         "Large",IDC_VIEW_LARGE,"Button",BS_AUTORADIOBUTTON,15,46,80,10
    PUSHBUTTON      "?",IDC_HELP_BUTTON,7,71,14,14
    DEFPUSHBUTTON   "OK",IDOK,67,71,50,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,123,71,50,14
END

IDD_ABOUTBOX DIALOGEX 0, 0, 250, 104
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About AlibreCAM"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDI_ALIBRECAM,IDC_STATIC,14,14,20,20
    LTEXT           "AlibreCAM Add-On for Alibre Design",IDC_STATIC,46,14,190,8,SS_NOPREFIX
    LTEXT           "Version",IDC_ADDON_VERSION,46,27,190,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2026 Frank's Workshop",IDC_STATIC,46,40,190,8,SS_NOPREFIX
    LTEXT           "Running in Alibre Design",IDC_ALIBRE_VERSION,46,58,190,16,SS_NOPREFIX
    DEFPUSHBUTTON   "OK",IDOK,186,83,50,14,WS_GROUP
END

IDD_TOOL_LIBRARY DIALOGEX 0, 0, 340, 232
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tool Library"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Library:",IDC_STATIC,7,9,26,8
